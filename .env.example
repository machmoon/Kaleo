# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
# Firestore datasheet-fact cache, read by service/app.py's build_store and by
# service/configuration.py. Any value but "0" enables it when GOOGLE_CLOUD_PROJECT
# is set; "0" forces the in-memory store. scripts/deploy.sh sets it to 1.
USE_FIRESTORE=1
# Selects the pipeline driver: "adk" runs the Google ADK workflow, "sdk" the straight-line pipeline; unset uses the built-in default (adk).
SILKSCREEN_ENGINE=
# Ollama/Tinker/hybrid appear only after the user opts in from the interface.
OLLAMA_PLACEMENT_URL=
OLLAMA_PLACEMENT_MODEL=gemma3:4b
TINKER_API_KEY=
# Promoted sampler checkpoint only, for example tinker://...; never a base model.
TINKER_PLACEMENT_MODEL=
# Defaults to artifacts/placement-failure-traces.jsonl outside Cloud/Firestore.
PLACEMENT_FAILURE_TRACE_PATH=
# Optional: with --bom / sourcing on, proposed MPNs are checked against Mouser's catalogue and marked verified when listed.
MOUSER_API_KEY=
# Root of the built web bundle; defaults to <repo>/frontend/dist, /app/frontend/dist in the container.
SILKSCREEN_WEB_DIST=
# Set to 1 to let the service accept an orchestrator model below the Gemini 3.5
# hackathon floor (service/models.py:41). Unset, such a request is a 400.
SILKSCREEN_ALLOW_LEGACY_MODELS=
# Worker model for the front ends that have no --model flag of their own
# (googleapps/config.py:126, slackbot/config.py:129; reported by
# service/integrations.py:376). Empty uses each package's DEFAULT_MODEL.
SILKSCREEN_MODEL=
# Seconds one worker model call may take before it fails over
# (engine/silkscreen/agents/model.py:55 TIMEOUT_ENV_VAR). Unset uses the built-in default.
SILKSCREEN_MODEL_TIMEOUT_S=
# Where the desktop overlay's approval-gated step sessions write their files
# (service/steps.py:231). Unset uses a temporary directory.
SILKSCREEN_STEPS_DIR=
# The `kicad-cli` binary the service shells out to for render / DRC / GLB export
# (service/kicad_cli.py:31). Set it when KiCad is not on PATH; it wins outright.
KICAD_CLI=
# Interpreter for the live-KiCad bridge desktop/kicad_live.py, which needs
# kicad-python and therefore cannot share the engine venv (service/steps.py:248).
# Unset tries the checkout's .venv-kicad. Missing means "cannot show", never an error.
SILKSCREEN_KICAD_LIVE_PYTHON=

# --- Local tool discovery (all optional; each names an executable) -----------
# ngspice/LTspice for engine/silkscreen/spice (simulators.py:60-61). Unset searches PATH.
SILKSCREEN_SPICE=
SILKSCREEN_LTSPICE=

# --- Setup Assistant (service/setup.py), the desktop's first-launch wizard ---
# KALEO_SETUP_MODE=demo makes every "connect" in the wizard a rehearsal:
# nothing reaches Google, Microsoft or Stripe, every response says demo=true,
# and the state lives under ~/.kaleo/demo/ (rm -r it to reset). Unset = live.
# Never a client flag: a UI bug must not be able to mint a "connected" state.
KALEO_SETUP_MODE=
# Where the wizard persists what you connect: ~/.kaleo/{google,microsoft,billing}.env
# (0600, read by the service at start; a value already in the environment wins).
KALEO_HOME=

# --- Usage metering on /generate (service/metering.py) ------------------------
# 1/true/on wires billing's reserve-then-commit around every /generate* run, so
# a run draws down KCU and reports what it cost. Unset (the default) is OFF and
# every run says so in words rather than reporting a cost nobody was charged.
# The service does NOT load .env: export it.
KALEO_METERING=

# --- Google Workspace delivery (googleapps/), for Chat / Gmail / Calendar ---
# Used by `python -m googleapps` and by the Hardy overlay "Send it on" panel
# (via the service). The service does NOT load .env — export these into the
# shell that runs `PORT=8081 python -m service.app`, or use `set -a && . ./.env`.
# See docs/googleapps.md.
GOOGLEAPPS_CHAT_WEBHOOK=
GOOGLEAPPS_CLIENT_ID=
GOOGLEAPPS_CLIENT_SECRET=
# Optional; default ~/.config/silkscreen/google-token.json after Sign in with
# Google in Hardy's Send panel (or `python -m googleapps auth`).
GOOGLEAPPS_TOKEN_PATH=

# --- Slack bot (slackbot/), only needed to run `python -m slackbot` ---
# Bot User OAuth Token from OAuth & Permissions, after installing the app.
SLACK_BOT_TOKEN=
# Basic Information -> Signing Secret. Every request is verified against this.
SLACK_SIGNING_SECRET=
# Port the bot listens on (Slack must be able to reach it). Default 3000.
SILKSCREEN_SLACK_PORT=3000
# Comma-separated channel IDs the bot will answer in. Empty means any channel
# it has been invited to.
SILKSCREEN_SLACK_CHANNELS=
# How many times a bad model proposal goes back as a repair prompt (slackbot/config.py:131).
SILKSCREEN_SLACK_REPAIRS=3
# Concurrent design runs. Each costs model calls and a CP-SAT solve.
SILKSCREEN_SLACK_MAX_RUNS=2
# Placement solver budget per run, in seconds.
SILKSCREEN_SLACK_TIME_LIMIT=20
# Where each run's artifacts are written.
SILKSCREEN_SLACK_WORKDIR=slack-runs

# --- Slack -> Hardy on this laptop (`python -m slackbot socket`, Socket Mode) ---
# No public URL and no signing secret: the bridge dials out to Slack and hands
# each idea to the Ada overlay through the engine's /inbox. Needs SLACK_BOT_TOKEN
# above plus an app-level token (Basic Information -> App-Level Tokens, scope
# connections:write), and websocket-client (pip install -e ".[slack]").
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs allowed to start a design on this laptop.
# Empty means anyone who can DM or mention the app. The first step spends.
SILKSCREEN_SLACK_USERS=
# Where the engine is. Default http://127.0.0.1:8081 (`silkscreen serve`).
SILKSCREEN_ENGINE_URL=

# --- Zoom front end (zoombot/), only needed to run `python -m zoombot` ---
# Never run against a live Zoom account; see docs/zoom.md before relying on it.
# Server-to-Server OAuth app: Client ID (also signs the RTMS handshake).
ZOOM_CLIENT_ID=
# Server-to-Server OAuth app: Client Secret.
ZOOM_CLIENT_SECRET=
# Server-to-Server OAuth app: Account ID, for the account_credentials grant.
ZOOM_ACCOUNT_ID=
# Webhook Secret Token: verifies x-zm-signature and answers url_validation.
ZOOM_WEBHOOK_SECRET_TOKEN=
# Ingest Realtime Media Streams: 1/true/yes/on or 0/false/no/off. Default on.
ZOOM_RTMS_ENABLED=true
# How the agent answers: sdk (needs the unbuilt zoombot/bot/ container) | chat | off.
ZOOM_SPEAK_MODE=chat
# Comma-separated meeting IDs. Empty means EVERY meeting these credentials see.
ZOOM_MEETINGS=
# Cap on paid pipeline runs from one meeting. Must be >= 1. Default 2.
ZOOM_MAX_RUNS_PER_MEETING=2
# Zoom REST base; must be https and pinned to /v<N>. Default https://api.zoom.us/v2.
ZOOM_API_BASE=
# Port `python -m zoombot` binds; the Zoom dashboard's endpoint URL points here. Default 8095.
ZOOM_PORT=8095
# Read only by the headless container in zoombot/bot/, never by the Python package:
# the Meeting SDK app's credentials that sign the join JWT.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- Microsoft Teams front end (teamsbot/), for `python -m teamsbot` ---
# Never run against a live Microsoft 365 tenant; see docs/teams.md.
# Entra ID (Azure AD) app registration: client ID. Also the JWT audience checked on every callback.
TEAMS_APP_ID=
# Entra ID app registration: client secret, for the client-credentials grant.
TEAMS_APP_SECRET=
# Entra ID directory (tenant) ID; forms the login.microsoftonline.com token URL.
TEAMS_TENANT_ID=
# Public https callback URL Teams POSTs to. Required only when TEAMS_SPEAK_MODE=sdk.
TEAMS_BOT_ENDPOINT=
# How the agent answers: sdk (needs the unbuilt teamsbot/bot/ calling bot) | chat | off.
TEAMS_SPEAK_MODE=chat
# Comma-separated meeting IDs. Empty means EVERY meeting these credentials see.
TEAMS_MEETINGS=
# Cap on paid pipeline runs from one meeting. Must be >= 1. Default 2.
TEAMS_MAX_RUNS_PER_MEETING=2
# Microsoft Graph base; https, pinned to /v1.0 or /beta. Default https://graph.microsoft.com/v1.0.
TEAMS_GRAPH_BASE=
# Port `python -m teamsbot` binds; the callback URL registered with Microsoft points here. Default 3978.
TEAMS_PORT=3978

# --- Kaleo desktop (app/) local "Hey Ada" wake ---
# Open-source on-device classifier (livekit-wakeword / openWakeWord lineage).
# No Picovoice. Command STT after a hit stays Google POST /transcribe.
# ElevenLabs is TTS-only (Settings voice), not wake spotting.
# Drop a classifier ONNX here, or train "hey Ada" with:
#   https://github.com/livekit/livekit-wakeword
KALEO_WAKE_ONNX=
# Optional directory of *.onnx classifiers; optional score threshold (0–1).
KALEO_WAKE_MODEL_DIR=
# Measured on the shipped hey_ada classifier: 0.7 gives recall 0.867 with
# zero false accepts/hour; 0.5 gives 0.917 but 1.40/hour and lets "hey
# Aidan" through. Lower it only if the wake word feels unresponsive.
KALEO_WAKE_THRESHOLD=0.7
# Offline / demo without an ONNX: set to 1, arm the ear, ⌥-click to simulate.
KALEO_WAKE_MOCK=
# Read by the Rust shell, not by Python. The .env the app loads at startup
# (app/src-tauri/src/wake/config.rs:226); only KALEO_WAKE* keys are taken from it.
KALEO_DOTENV_PATH=
# The silkscreen checkout the app shells out to when it cannot infer one
# (app/src-tauri/src/cli.rs:39).
SILKSCREEN_ROOT=

# --- Billing (billing/) -------------------------------------------------
# A RESTRICTED key (rk_), not a secret key (sk_). Give it only the two
# permissions this package needs: Checkout Sessions write, and read.
# Store it in your platform's secrets vault; this file is for names, not values.
STRIPE_API_KEY=
# The signing secret for THIS endpoint, from the webhook's own page.
STRIPE_WEBHOOK_SECRET=
# The price of one credit pack. A price id, not a product id.
STRIPE_PRICE_ID=
# Compute granted per pack purchased, in milli-KCU. 8888 = 8.888 KCU.
STRIPE_CREDIT_MKCU=8888
# Charged per KCU on drawdown, in integer cents.
KALEO_RATE_CENTS_PER_KCU=225
STRIPE_SUCCESS_URL=kaleo://billing/success
STRIPE_CANCEL_URL=kaleo://billing/cancel
