# The repo root mixes the live tree (engine/, service/, frontend/, scripts/,
# docs/) with retired pre-rewrite code and its build droppings. See
# docs/repo-layout.md for what is alive and what is not. Rules here only stop
# NEW junk from being committed -- nothing already tracked is affected by them.

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg-info
build/
dist/
.venv/
.venv-kicad/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Secrets
.env
.env.*
!.env.example

# Node
# frontend/dist/ stays ignored even though service/app.py serves it and the
# Dockerfile depends on it: it is reproducible from frontend/src by
# `npm run build`, and the Dockerfile's node stage builds it inside the image
# rather than copying a committed one. Committing it would mean every UI change
# carried a second, hand-synced copy of itself -- the classic way a served
# bundle silently drifts from its source. Local `python -m service.app` needs a
# build first; that is the documented workflow in CLAUDE.md.
node_modules/
frontend/dist/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.vite/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.eslintcache

# SKiDL / KiCad generated artifacts -- all regenerable, none belong in git
*.erc
*.net
*.log
*_sklib.py
lib_pickle_dir/
*.pkl

# KiCad backups
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache

# Generated symbol index (built from a local KiCad install)
symbols.json

# Scraped caches
component_img/
C[0-9]*.json
C[0-9]*.jpg
adjacency_*.json

# OS junk. macOS writes .DS_Store into every browsed directory and ._* AppleDouble
# forks onto non-HFS volumes; Windows writes Thumbs.db and Desktop.ini. Four
# people on mixed machines push to main, so each of these has a real chance of
# arriving in a commit from whichever OS is not yours.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated boards
placed.kicad_pcb
generated.kicad_pcb

# Local training traces and checkpoints
artifacts/

# Seeded design canvas — generated from design/*.dc.html, 2MB of bundled editor
design/silkscreen-ui.html
.gstack/

# Slack bot run artifacts (boards, previews, order drafts).
slack-runs/
# AI CAD / enclosure (docs/ai-cad-plan.md). The OpenSCAD C++ source may be
# cloned locally as a read-only reference and must NEVER be committed (GPL-2.0
# stays outside this MIT project -- see vendor/README.md). Render outputs are
# regenerable from the .scad via the locally installed openscad binary.
# Deliberately NOT *.scad wholesale: emitted sources and test fixtures must
# stay trackable.
vendor/openscad/
*.stl
enclosure.png

# A ledger accidentally pointed inside the checkout (KALEO_LEDGER_PATH).
# It holds real balances and Stripe event ids; it is never repository content.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Agent scratch space, never part of the project.
scratchpad/
