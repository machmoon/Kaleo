# Editor defaults for a four-person, mixed-OS team. This file only configures
# editors -- it enforces nothing. Python style is owned by ruff (see
# pyproject.toml) and this file is set to agree with it; if the two ever
# disagree, ruff wins and this file is the one to change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Matches ruff's line-length = 88 in pyproject.toml.
max_line_length = 88

[*.{js,svelte,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them
# silently reflows the rendered text.
trim_trailing_whitespace = false

[*.kicad_pcb]
# Board files are generated by kiutils and round-tripped by tests. An editor
# reformatting one on save is the board-destroying edit this repo guards
# against everywhere else -- do not let it touch whitespace.
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = tab

[Makefile]
indent_style = tab

[vendor/**]
# Read-only vendored reference code (CLAUDE.md): no editor normalisation.
trim_trailing_whitespace = false
insert_final_newline = false
